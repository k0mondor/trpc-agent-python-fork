{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trpc.group/schemas/session-memory-replay-report-v4.json",
  "title": "Session/Memory Replay Consistency Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "cases"],
  "properties": {
    "schema_version": {"const": 4},
    "meta": {
      "type": "object",
      "required": [
        "mode",
        "elapsed_seconds",
        "backend_names",
        "baseline_backend",
        "comparison_mode",
        "acceptance_case_count",
        "extra_case_count",
        "quality_metrics"
      ],
      "properties": {
        "mode": {"type": "string"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "backend_names": {"type": "array", "items": {"type": "string"}},
        "baseline_backend": {"type": "string"},
        "comparison_mode": {"type": "string"},
        "clock_strategy": {"type": "object"},
        "acceptance_case_count": {"type": "integer", "minimum": 0},
        "extra_case_count": {"type": "integer", "minimum": 0},
        "quality_metrics": {"type": "object"}
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "description", "scenario_type"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "scenario_type": {"enum": ["normal_and_injected", "extended"]},
          "normal_comparisons": {"type": "array"},
          "injected_comparisons": {"type": "array"},
          "comparisons": {"type": "array"},
          "diffs": {"type": "array"}
        }
      }
    }
  }
}
